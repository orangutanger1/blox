-- @context edit
local RS = game:GetService("ReplicatedStorage")
local function cfg() return require(RS:WaitForChild("PetConfig", 2)) end
local function logic() return require(RS:WaitForChild("PetLogic", 2)) end
test("config: values and rarity order", function()
	local c = cfg()
	expect(c.StartCash).toBe(100)
	expect(c.EggCost).toBe(50)
	expect(c.MaxPets).toBe(12)
	expect(c.RebirthCost).toBe(1000)
	expect(c.RebirthMultiplier).toBe(1.5)
	expect(#c.Rarities).toBe(3)
	expect(c.Rarities[1].Name).toBe("Common")
	expect(c.Rarities[3].Name).toBe("Legendary")
end)
test("logic: rollRarity boundaries", function()
	local L = logic()
	expect(L.rollRarity(0)).toBe("Common")
	expect(L.rollRarity(0.6999)).toBe("Common")
	expect(L.rollRarity(0.70)).toBe("Rare")
	expect(L.rollRarity(0.9499)).toBe("Rare")
	expect(L.rollRarity(0.95)).toBe("Legendary")
	expect(L.rollRarity(0.99999)).toBe("Legendary")
end)
test("logic: incomePerSecond with rebirth multiplier", function()
	local L = logic()
	expect(L.incomePerSecond({}, 0)).toBe(0)
	expect(L.incomePerSecond({ "Common", "Rare" }, 0)).toBe(6)
	expect(L.incomePerSecond({ "Legendary" }, 2)).toBeCloseTo(56.25)
	expect(L.incomePerSecond({ "Rare", "Rare", "Common" }, 1)).toBeCloseTo(16.5)
end)
