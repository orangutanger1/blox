-- @context edit
local Format = require(game:GetService("ReplicatedStorage").Kit.Format)

describe("abbreviate", function()
	test("small numbers are whole", function()
		expect(Format.abbreviate(0)).toBe("0")
		expect(Format.abbreviate(999.9)).toBe("999")
	end)
	test("3 significant digits with suffix", function()
		expect(Format.abbreviate(1234)).toBe("1.23K")
		expect(Format.abbreviate(12345)).toBe("12.3K")
		expect(Format.abbreviate(123456)).toBe("123K")
		expect(Format.abbreviate(4.56e6)).toBe("4.56M")
		expect(Format.abbreviate(-2500)).toBe("-2.50K")
	end)
	test("never rounds up into the next tier", function()
		expect(Format.abbreviate(999960)).toBe("999K")
	end)
end)

test("duration", function()
	expect(Format.duration(38)).toBe("38s")
	expect(Format.duration(725)).toBe("12m05s")
	expect(Format.duration(3720)).toBe("1h02m")
end)
